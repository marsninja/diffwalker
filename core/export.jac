glob ICONS: dict[str, str] = {
         "critical": "🔴",
         "high": "🟠",
         "medium": "🟡",
         "low": "🔵",
         "info": "⚪"
     },
     VERDICTS: dict[str, str] = {
         "approve": "✅ Approve",
         "comment": "💬 Comment",
         "request_changes": "⛔ Request changes"
     };

def review_markdown(rv: Review, findings: list[Finding]) -> str {
    open_fs = [
        f
        for f in findings
        if f.status != "dismissed"
    ];
    lines: list[str] = [
        f"## Diffwalker review: {VERDICTS.get(rv.verdict, rv.verdict)} (risk {rv.risk}/100)",
        "",
        rv.summary,
        ""
    ];
    if rv.intent {
        lines = lines + ["**Intent.** " + rv.intent, ""];
    }
    if rv.concerns {
        lines.append("### Top concerns");
        lines = lines + [f"- {c}" for c in rv.concerns] + [""];
    }
    files = review_files(rv);
    if files {
        lines = lines
            + ["### Walkthrough", "", "| File | Risk | Change |", "|---|---:|---|"];
        lines = lines
            + [
                f"| `{n.path}` | {n.risk} | {n.summary or '(' + n.state + ')'} |"
                for n in files[:30]
            ];
        lines.append("");
    }
    if open_fs {
        lines.append(f"### Findings ({len(open_fs)})");
        for f in open_fs {
            lines.append("");
            lines.append(
                f"{ICONS.get(f.severity, '')} **{f.title}** · `{f.path}:{f.line}` · {f.severity}/{f.category}"
            );
            lines.append("");
            lines.append(f.body);
            if f.suggestion {
                lines = lines + ["", "```suggestion", f.suggestion, "```"];
            }
        }
        lines.append("");
    }
    if rv.tests {
        lines.append("### Suggested tests");
        lines = lines + [f"- {t}" for t in rv.tests] + [""];
    }
    if rv.cost {
        lines.append(f"_{rv.llm_calls} model calls · {rv.tokens} tokens · ${rv.cost} on {rv.model}_");
        lines.append("");
    }
    lines.append("_Generated by Diffwalker, an agentic reviewer written in Jac._");
    return "\n".join(lines);
}
